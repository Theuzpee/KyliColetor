# Ambiente
NODE_ENV=development

# Banco de dados (Supabase)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.XXXX.supabase.co:5432/postgres

# Autenticação JWT
JWT_SECRET=substitua_por_um_secret_forte_aqui
JWT_EXPIRES_IN=8h

# Integração ERP (API Key para sincronização de usuários)
ERP_API_KEY=substitua_por_uma_api_key_forte_aqui

# CORS (origens permitidas em produção, separadas por vírgula)
ALLOWED_ORIGINS=https://portal.grupokyly.com.br,https://admin.grupokyly.com.br

# Servidor
PORT=3000
